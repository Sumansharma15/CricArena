<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.CricArena" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primaryDark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/primaryDark</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Widget.CricArena.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.CricArena.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.CricArena.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/buttonPrimary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.CricArena.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.CricArena.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/buttonSoft</item>
        <item name="strokeColor">@color/buttonBorder</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Widget.CricArena.CircleButton" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.CricArena.FullPill</item>
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.CricArena.CircleButton.Extra" parent="Widget.CricArena.CircleButton">
        <item name="backgroundTint">@color/accent</item>
    </style>

    <style name="Widget.CricArena.CircleButton.Danger" parent="Widget.CricArena.CircleButton">
        <item name="backgroundTint">@color/liveRed</item>
    </style>

    <style name="Widget.CricArena.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CricArena.FullPill</item>
    </style>

    <style name="TextAppearance.CricArena.BottomNav.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CricArena.BottomNav.Inactive" parent="TextAppearance.Material3.LabelMedium" />

    <style name="ShapeAppearance.CricArena.FullPill" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.CricArena.Button" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>