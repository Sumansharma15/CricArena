<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarScoring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:titleTextColor="@color/headerTextOnGradient" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/runs_points"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutRunButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRun0"
                        style="@style/Widget.CricArena.CircleButton"
                        android:text="0" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRun1"
                        style="@style/Widget.CricArena.CircleButton"
                        android:layout_marginStart="8dp"
                        android:text="1" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRun2"
                        style="@style/Widget.CricArena.CircleButton"
                        android:layout_marginStart="8dp"
                        android:text="2" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRun3"
                        style="@style/Widget.CricArena.CircleButton"
                        android:layout_marginStart="8dp"
                        android:text="3" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRun4"
                        style="@style/Widget.CricArena.CircleButton"
                        android:layout_marginStart="8dp"
                        android:text="4" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRun6"
                        style="@style/Widget.CricArena.CircleButton"
                        android:layout_marginStart="8dp"
                        android:text="6" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textExtras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/extras"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutExtras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonWide"
                        style="@style/Widget.CricArena.CircleButton.Extra"
                        android:text="@string/wide_short" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonNoBall"
                        style="@style/Widget.CricArena.CircleButton.Extra"
                        android:layout_marginStart="12dp"
                        android:text="@string/no_ball_short" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonBye"
                        style="@style/Widget.CricArena.CircleButton.Extra"
                        android:layout_marginStart="12dp"
                        android:text="@string/bye_short" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/player_performance_title"
                    android:textColor="@color/textPrimary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonWicket"
                        style="@style/Widget.CricArena.CircleButton.Danger"
                        android:text="@string/wicket_out_label" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonPlayerWicket"
                        style="@style/Widget.CricArena.CircleButton"
                        android:layout_marginStart="12dp"
                        android:text="@string/player_wicket_short" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonCatch"
                        style="@style/Widget.CricArena.CircleButton"
                        android:layout_marginStart="12dp"
                        android:text="@string/catch_label" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/player_scoring_point_guide"
                    android:textColor="@color/textSecondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
